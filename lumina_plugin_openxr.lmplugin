{
  "name": "lumina_plugin_openxr",
  "friendly_name": "OpenXR Support",
  "version": "0.1.0",
  "description": "Khronos OpenXR runtime management, HMD and controller tracking components, and stereoscopic rendering for Lumina Studio.",
  "category": "Virtual Reality",
  "license": "MIT",
  "changelog": "CHANGELOG.md",
  "authors": [
    "Lumina"
  ],
  "engine_version": ">=0.0.1 <1.0.0",
  "can_contain_content": true,
  "isolation": "process",
  "modules": [
    {
      "name": "lumina_plugin_openxr",
      "type": "editor",
      "entry_library": "lib/lumina_plugin_openxr.dart",
      "process_class": "LuminaPluginOpenxrProcess"
    },
    {
      "name": "lumina_plugin_openxr_runtime",
      "type": "runtime",
      "entry_library": "lib/runtime.dart",
      "registration_class": "LuminaOpenXrRuntime"
    }
  ],
  "android": {
    "uses_features": [
      {
        "name": "android.hardware.vr.headtracking",
        "required": true,
        "version": 1
      }
    ],
    "permissions": [
      "org.khronos.openxr.permission.OPENXR",
      "org.khronos.openxr.permission.OPENXR_SYSTEM"
    ],
    "intent_categories": [
      "com.oculus.intent.category.VR",
      "org.khronos.openxr.intent.category.IMMERSIVE_HMD"
    ],
    "queries": [
      "<provider android:authorities=\"org.khronos.openxr.runtime_broker;org.khronos.openxr.system_runtime_broker\" />",
      "<intent><action android:name=\"org.khronos.openxr.OpenXRRuntimeService\" /></intent>"
    ],
    "activity_attributes": {
      "screenOrientation": "landscape",
      "launchMode": "singleTask",
      "resizeableActivity": "false",
      "configChanges": "density|keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
    }
  }
}
